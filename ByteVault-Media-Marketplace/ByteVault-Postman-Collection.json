{
  "info": {"name":"ByteVault Marketplace","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:8080"},{"key":"token","value":""},{"key":"orderId","value":"1"}],
  "item":[
    {"name":"1. Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"username\": \"student\",\n  \"password\": \"student123\"\n}"},"url":{"raw":"{{baseUrl}}/api/auth/login","host":["{{baseUrl}}"],"path":["api","auth","login"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Login successful', () => pm.response.code === 200);","const json = pm.response.json();","pm.collectionVariables.set('token', json.token);"]}}]},
    {"name":"2. List Products","request":{"method":"GET","url":{"raw":"{{baseUrl}}/api/products","host":["{{baseUrl}}"],"path":["api","products"]}}},
    {"name":"3. Purchase Product 1","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"productId\": 1\n}"},"url":{"raw":"{{baseUrl}}/api/orders/purchase","host":["{{baseUrl}}"],"path":["api","orders","purchase"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Purchase successful', () => pm.response.code === 200);","const json = pm.response.json();","pm.collectionVariables.set('orderId', json.orderId);"]}}]},
    {"name":"4. My Orders","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":{"raw":"{{baseUrl}}/api/orders/my","host":["{{baseUrl}}"],"path":["api","orders","my"]}}},
    {"name":"5. Download (copy token from purchase response)","request":{"method":"GET","url":{"raw":"{{baseUrl}}/api/orders/download/{{orderId}}?token=PASTE_SIGNED_TOKEN_HERE","host":["{{baseUrl}}"],"path":["api","orders","download", "{{orderId}}"],"query":[{"key":"token","value":"PASTE_SIGNED_TOKEN_HERE"}]}}}
  ]
}
